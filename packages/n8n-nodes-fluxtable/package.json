{
  "name": "n8n-nodes-fluxtable",
  "version": "1.0.0",
  "description": "Conector especializado de n8n para FluxTable (Sistema Yarken) con soporte de operaciones batch, gestión de esquemas, snapshots, webhooks y analítica",
  "license": "MIT",
  "homepage": "https://wiki.yarken.cl",
  "keywords": [
    "n8n-community-node-package"
  ],
  "author": {
    "name": "Sebastián Nadales",
    "email": "snadales@gmail.com"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "dist/nodes/FluxTable/FluxTable.node.js",
      "dist/nodes/FluxTable/FluxTableTrigger.node.js"
    ],
    "credentials": [
      "dist/credentials/FluxTableApi.credentials.js"
    ]
  },
  "devDependencies": {
    "n8n-workflow": "^1.60.0",
    "typescript": "^5.6.3"
  }
}
