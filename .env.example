# ==============================================================================
# BaserowLite - Variables de Entorno (Plantilla)
# ==============================================================================
# IMPORTANTE: Nunca registrar valores reales en el repositorio.
# Copiar este archivo a .env y completar con credenciales seguras.

# ------------------------------------------------------------------------------
# 1. Configuración de Aplicación y Servidor
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clave secreta para firma de sesiones y tokens (generar con `openssl rand -hex 32`)
APP_SECRET=op://IA/BaserowLite/app_secret

# ------------------------------------------------------------------------------
# 2. Base de Datos PostgreSQL
# ------------------------------------------------------------------------------
# Conexión utilizada por Drizzle ORM
DATABASE_URL=postgresql://baserow_user:password_placeholder@localhost:5432/baserow_lite

# Parámetros para el contenedor PostgreSQL en Docker Compose
POSTGRES_DB=baserow_lite
POSTGRES_USER=baserow_user
POSTGRES_PASSWORD=op://IA/BaserowLite/postgres_password
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 3. Almacenamiento de Archivos Adjuntos
# ------------------------------------------------------------------------------
# Opciones de driver: "local" | "s3"
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./data/uploads

# Parámetros opcionales si STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
