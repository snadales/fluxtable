# ==============================================================================
# FluxTable - Variables de Entorno (Plantilla de Producción y Desarrollo)
# Plataforma de Datos & BI | Sistema Yarken
# ==============================================================================
# IMPORTANTE: Nunca registrar valores reales en el repositorio.
# Copiar este archivo a .env y completar con credenciales seguras vía 1Password.

# ------------------------------------------------------------------------------
# 1. Configuración de Aplicación y Servidor
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
APP_URL=https://fluxtable.yarken.cl
NEXT_PUBLIC_APP_URL=https://fluxtable.yarken.cl

# Clave secreta para firma de sesiones y tokens (generar con `openssl rand -hex 32`)
APP_SECRET=op://IA/FluxTable/app_secret

# Control de acceso por correo electrónico (whitelist separada por comas)
ALLOWED_EMAILS=snadales@gmail.com

# ------------------------------------------------------------------------------
# 2. Base de Datos Principal FluxTable (PostgreSQL 16)
# ------------------------------------------------------------------------------
# Conexión utilizada por Drizzle ORM
DATABASE_URL=postgresql://fluxtable_user:password_placeholder@postgres:5432/fluxtable

# Parámetros para el contenedor PostgreSQL en Docker Compose
POSTGRES_DB=fluxtable
POSTGRES_USER=fluxtable_user
POSTGRES_PASSWORD=op://IA/FluxTable/postgres_password
POSTGRES_PORT=5435

# ------------------------------------------------------------------------------
# 3. Almacenamiento de Archivos Adjuntos
# ------------------------------------------------------------------------------
# Opciones de driver: "local" | "s3"
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=/app/storage/uploads

# Parámetros opcionales si STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ------------------------------------------------------------------------------
# 4. Motor de BI & Fuentes Analíticas Remotas (Solo Lectura)
# ------------------------------------------------------------------------------
# Webhook para alertas automáticas y monitor de umbrales en n8n
BI_ALERT_WEBHOOK_URL=http://192.168.60.25:5678/webhook/bi-alerts

# Fuente 1: Odoo ERP (PostgreSQL)
ODOO_DB_HOST=odoo20_db
ODOO_DB_PORT=5432
ODOO_DB_USER=baserow_ro
ODOO_DB_PASSWORD=op://IA/FluxTable/bi_odoo_ro_password
ODOO_DB_NAME=odoo_prod

# Fuente 2: Voz Service (PostgreSQL)
VOZ_DB_HOST=voz-db
VOZ_DB_PORT=5432
VOZ_DB_USER=baserow_ro
VOZ_DB_PASSWORD=op://IA/FluxTable/bi_voz_ro_password
VOZ_DB_NAME=voz

# Fuente 3: Pimcore PIM (MySQL / MariaDB)
PIMCORE_DB_HOST=pimcore-db-1
PIMCORE_DB_PORT=3306
PIMCORE_DB_USER=baserow_ro
PIMCORE_DB_PASSWORD=op://IA/FluxTable/bi_pimcore_ro_password
PIMCORE_DB_NAME=pimcore
