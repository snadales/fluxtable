# ==============================================================================
# Insumo de /home/snadales/docker/1password/resolve-env.sh (zbook)
# Cada op:// se resuelve contra 1Password Connect y se escribe en .env (chmod 600)
# ==============================================================================

PORT=8097
POSTGRES_PORT=5435
POSTGRES_DB=op://IA/zbook_docker_fluxtable_config/postgres_db
POSTGRES_USER=op://IA/zbook_docker_fluxtable_config/postgres_user
POSTGRES_PASSWORD=op://IA/zbook_docker_fluxtable_config/postgres_password
DATABASE_URL=op://IA/zbook_docker_fluxtable_config/database_url
APP_SECRET=op://IA/zbook_docker_fluxtable_config/app_secret
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=/app/storage/uploads
ALLOWED_EMAILS=op://IA/zbook_docker_fluxtable_config/allowed_emails
ADMIN_EMAIL=snadales@gmail.com
APP_URL=https://fluxtable.yarken.cl
NEXT_PUBLIC_APP_URL=https://fluxtable.yarken.cl
PASSWORD_LOGIN_ENABLED=false
CF_ACCESS_TEAM_DOMAIN=op://IA/zbook_fluxtable_cf_access/team_domain
CF_ACCESS_AUD=op://IA/zbook_fluxtable_cf_access/aud
GOOGLE_CLIENT_ID=op://IA/zbook_fluxtable_google_oauth/client_id
GOOGLE_CLIENT_SECRET=op://IA/zbook_fluxtable_google_oauth/client_secret
